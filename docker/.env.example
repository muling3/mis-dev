# Image references for the "run from existing images" path (docker/services.yml).
# Copy to docker/.env and edit to point at a registry or bump a tag without
# touching compose or the Makefile:
#   cp docker/.env.example docker/.env
#
# Build images that match these tags with:  make images-build
# Run them without rebuilding with:          make services-up

AUTH_IMAGE=mis/auth-service:dev
REGISTRATION_IMAGE=mis/registration-service:dev
CASE_IMAGE=mis/case-service:dev
SANDBOX_IMAGE=mis/sandbox-service:dev
NOTIFICATION_IMAGE=mis/notification-service:dev
REPORTING_IMAGE=mis/reporting-service:dev
DOCUMENT_IMAGE=mis/document-service:dev
ADMIN_IMAGE=mis/admin-service:dev
